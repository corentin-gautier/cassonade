{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/java-warnings.sh",
            "timeout": 180,
            "statusMessage": "Checking Java warnings..."
          }
        ]
      }
    ]
  }
}
