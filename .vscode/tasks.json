{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run minecraft",
			"type": "shell",
			"command": "./gradlew runClient",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Run automated tests",
			"type": "shell",
			"command": "./gradlew runClientGameTest",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Build the mod jar",
			"type": "shell",
			"command": "./gradlew build",
			"problemMatcher": []
		},
		{
			"label": "Take screenshots",
			"type": "shell",
			"command": "./gradlew runClientGameTest -PsiteScreenshots && tools/convert-screenshots.sh",
			"problemMatcher": []
		},
		{
			"label": "Preview the website",
			"type": "shell",
			"command": "trap 'rm -rf _site promo/site/.jekyll-cache' EXIT INT TERM HUP; jekyll serve --source promo/site --livereload --open-url",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Clean the project",
			"type": "shell",
			"command": "./gradlew clean",
			"problemMatcher": []
		}
	]
}
