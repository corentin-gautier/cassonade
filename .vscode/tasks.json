{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run minecraft",
			"type": "shell",
			"command": "./gradlew runClient",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": {
				"owner": "javac",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+\\.java):(\\d+): (error|warning): (.+)$",
					"file": 1,
					"line": 2,
					"severity": 3,
					"message": 4
				}
			}
		},
		{
			"label": "Run minecraft for debugging",
			"detail": "Started by the \"Debug minecraft\" launch (F5), which attaches to it",
			"type": "shell",
			"command": "./gradlew runClient --debug-jvm",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": {
				"owner": "javac",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+\\.java):(\\d+): (error|warning): (.+)$",
					"file": 1,
					"line": 2,
					"severity": 3,
					"message": 4
				},
				"background": {
					"activeBegins": true,
					"beginsPattern": "^",
					"endsPattern": "Listening for transport dt_socket at address"
				}
			}
		},
		{
			"label": "Update textures and languages",
			"detail": "Then F3+T in the game reloads them",
			"type": "shell",
			"command": "./gradlew processResources processClientResources",
			"problemMatcher": []
		},
		{
			"label": "Run automated tests",
			"type": "shell",
			"command": "./gradlew runClientGameTest",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": {
				"owner": "javac",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+\\.java):(\\d+): (error|warning): (.+)$",
					"file": 1,
					"line": 2,
					"severity": 3,
					"message": 4
				}
			}
		},
		{
			"label": "Build the mod jar",
			"type": "shell",
			"command": "./gradlew build",
			"problemMatcher": {
				"owner": "javac",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+\\.java):(\\d+): (error|warning): (.+)$",
					"file": 1,
					"line": 2,
					"severity": 3,
					"message": 4
				}
			}
		},
		{
			"label": "Take screenshots",
			"type": "shell",
			"command": "./gradlew runClientGameTest -PsiteScreenshots && tools/convert-screenshots.sh",
			"problemMatcher": []
		},
		{
			"label": "Preview the website",
			"type": "shell",
			"command": "trap 'rm -rf _site promo/site/.jekyll-cache' EXIT INT TERM HUP; jekyll serve --source promo/site --livereload --open-url",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Clean the project",
			"type": "shell",
			"command": "./gradlew clean",
			"problemMatcher": []
		}
	]
}
