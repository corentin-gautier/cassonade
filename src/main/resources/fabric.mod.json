{
	"schemaVersion": 1,
	"id": "cassonade",
	"version": "${version}",
	"name": "Cassonade",
	"description": "Quality-of-life tweaks that stay close to vanilla: a backpack, a compass minimap, a world map with waypoints, a clock with the weather forecast, an elytra slot, a quest journal, combat awareness, filtering hoppers, inventory sorting, right-click harvest, fairer recipes and a warmer interface.",
	"authors": [
		"Corentin"
	],
	"contact": {
		"homepage": "https://corentin-gautier.github.io/cassonade/",
		"sources": "https://github.com/corentin-gautier/cassonade",
		"issues": "https://github.com/corentin-gautier/cassonade/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/cassonade/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cassonade.Cassonade"
		],
		"client": [
			"com.cassonade.client.CassonadeClient"
		]
	},
	"mixins": [
		"cassonade.mixins.json",
		{
			"config": "cassonade.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
